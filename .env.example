# このファイルを複製して「.env」という名前で保存し、そちらに実際の値を書きます。
# .env は .gitignore に入れてあるので、Gitには上がりません。
#
# ※ Windowsは拡張子が隠れています。保存したファイルが「.env.txt」に
#    なっていないか確認してください。

# Google AI Studio (https://aistudio.google.com/apikey) で取得したAPIキー
GEMINI_API_KEY=ここにAPIキーを貼り付け


# ------------------------------------------------------------------
# 動作確認用のスイッチ（普段は不要）
# ------------------------------------------------------------------
# core/config.py の PROVIDER を "stub"（ダミー）にしているときだけ効きます。
# 1 にすると生成がわざと失敗し、エラー画面の出かたを確認できます。
# STUB_FORCE_ERROR=1
